
# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files containing sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plan files
*.tfplan
*.plan

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI configuration
.terraformrc
terraform.rc

# Sensitive files
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
